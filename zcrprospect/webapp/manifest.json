{
  "_version": "1.48.0",
  "sap.app": {
    "id": "porky.zcrprospect.zcrprospect",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.3",
      "toolsId": "aa0dc7a2-f2ec-4edf-872b-aee32b4d6311"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zsb_prospect_create/srvd/sap/zsd_prospect_create/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "zcrprospect-create": {
          "semanticObject": "zcrprospect",
          "action": "create",
          "title": "{{zcrprospect-create.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.108.44",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "porky.zcrprospect.zcrprospect.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },


    "resources": {
      "css": []
    },
 

"extends": {
  "extensions": {
    "sap.ui.controllerExtensions": {
      "sap.fe.templates.ListReport.ListReportController": {
        "controllerName": "porky.zcrprospect.zcrprospect.ext.controller.ListReportExt"
      }
    }
  }
},

    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZC_PROSPECT_CREATEList",
          "target": "ZC_PROSPECT_CREATEList"
        },
        {
          "pattern": "ZC_PROSPECT_CREATE({key}):?query:",
          "name": "ZC_PROSPECT_CREATEObjectPage",
          "target": "ZC_PROSPECT_CREATEObjectPage"
        }
      ],
      "targets": {
        "ZC_PROSPECT_CREATEList": {
          "type": "Component",
          "id": "ZC_PROSPECT_CREATEList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZC_PROSPECT_CREATE",
              "variantManagement": "Page",
              "navigation": {
                "ZC_PROSPECT_CREATE": {
                  "detail": {
                    "route": "ZC_PROSPECT_CREATEObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
               "controllerName": "porky.zcrprospect.zcrprospect.ext.controller.ListReportExt"
            }
          }
        },
        "ZC_PROSPECT_CREATEObjectPage": {
          "type": "Component",
          "id": "ZC_PROSPECT_CREATEObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ZC_PROSPECT_CREATE"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
